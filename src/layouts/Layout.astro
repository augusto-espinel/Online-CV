---
// Layout component for Augusto's CV
// Clean, executive portfolio style with Tailwind CSS
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Augusto Espinel Porras - Exergy Optimizer</title>
    <meta name="description" content="Thinker | Tinkerer | Energy Efficiency Expert | Systems Engineer" />
    <meta name="author" content="Augusto Espinel Porras" />
    <meta name="keywords" content="Systems Engineer, Energy Efficiency, Electric Vehicles, Power Electronics" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <script>
        // Smooth scroll behavior
        document.documentElement.style.scrollBehavior = 'smooth';
    </script>
    
    <style is:global>
        :root {
            --navy: #0d1b2a;
            --slate: #1b263b;
            --gold: #a8dadc; /* Glacial cyan/ice blue accent instead of gold */
            --slate-light: #415a77;
            --slate-dark: #0d1b2a;
            
            --glass-bg: rgba(27, 38, 59, 0.65);
            --glass-border: rgba(168, 218, 220, 0.15);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19; /* Neutral deep dark base to neutralize the blue */
            background-image: url('/Online-CV/assets/hero-bg.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-blend-mode: overlay;
            background-color: rgba(11, 15, 25, 0.25); /* Darken using a neutral, less blue tone */
            color: #e2e8f0;
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #415a77;
            border-radius: 4px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #a8dadc;
        }
        
        /* Section animations */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeIn 0.8s ease-out forwards;
        }
        
        @keyframes fadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .section-title::before {
            content: '';
            display: block;
            width: 180px;
            height: 3px;
            background: linear-gradient(90deg, var(--gold), var(--slate-light));
            margin-bottom: 20px;
        }
        
        /* Glassmorphism utility */
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        a, a:visited {
            color: var(--gold); /* Glacial light blue mapped to --gold */
            text-decoration: none;
        }
        
        a:hover {
            color: #ffffff; /* Turns white on hover like hero links */
        }

        /* Option A - Box Margins */
        :root {
            --panel-x: 6vw;
            --panel-y: 3rem;
        }

        @media (max-width: 1024px) {
            :root {
                --panel-x: 16px;
                --panel-y: 1.75rem;
            }
        }

        .section-wrap {
            margin: var(--panel-y) var(--panel-x);
            padding-left: clamp(2rem, 5vw, 4rem);
            padding-right: clamp(2rem, 5vw, 4rem);
            padding-bottom: clamp(1.5rem, 3vw, 2.5rem); /* Subdued bottom padding inside the panel */
        }

        /* Paragraph spacing: paragraphs should be slightly spaced apart from each other,
           while lines within the same paragraph (wrapped lines) stay compact. */
        .section-wrap p {
            margin: 0 0 1.25rem 0; /* slightly reduced gap between paragraphs */
            line-height: 1.20;     /* widened line-height for wrapped lines */
        }

        /* Paragraph lines and spacing across all sections for list items (li) */
        .section-wrap li {
            margin: 0 0 1.5rem 0; /* tighten list item vertical gaps */
            line-height: 1.25 !important; /* widen text wrapping inside list items */
        }

        /* Tighter spacing for skills section list items */
        #skills li {
            margin: 0 0 0.5rem 0 !important; /* much tighter between skill entries */
        }
    </style>
</head>
<body>
    <slot />
</body>
</html>
