---
import Layout from '../layouts/Layout.astro';
import { personalInfo, education, experience, honors, projects, publications, patents, skills, personalInterests } from '../data/cv-data';

const pageTitle = `${personalInfo.name} - ${personalInfo.title}`;
const pageDescription = personalInfo.tagline;
const pageKeywords = "Senior Architect, Systems Engineer, Energy Efficiency, Electric Vehicles, Power Electronics";
---
<Layout>
    <main class="container mx-auto px-4 sm:px-6 md:px-8 py-12 md:py-20 max-w-5xl space-y-12">
        <!-- Hero Header Section -->
        <header class="text-center fade-in glass-panel section-wrap pb-16 md:pb-24 p-10 md:p-16 lg:px-24 rounded-2xl relative overflow-hidden mt-4">
            <!-- Optional subtle gradient light behind text -->
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-[#a8dadc] opacity-5 blur-[100px] pointer-events-none rounded-full"></div>
            
            <h1 class="text-5xl md:text-7xl font-bold text-gold playfair-display mb-4 tracking-tight drop-shadow-md relative z-10">{personalInfo.name}</h1>
            <h2 class="text-2xl md:text-3xl font-semibold text-slate-100 mb-4 tracking-wide relative z-10">{personalInfo.title}</h2>
            <p class="text-lg md:text-xl text-slate-200 max-w-3xl mx-auto mb-10 leading-relaxed relative z-10">{personalInfo.tagline}</p>
            
            <div class="flex flex-wrap justify-center gap-8 md:gap-12 mt-10 text-lg relative z-10 px-4">
                <a href={`mailto:${personalInfo.contact.email}`} class="text-slate-200 hover:text-white hover:scale-105 transition-all bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fas fa-envelope mr-2 text-gold"></i> Email
                </a>
                <span class="text-slate-200 bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fas fa-map-marker-alt mr-2 text-gold"></i> {personalInfo.contact.location}
                </span>
                <a href={personalInfo.contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white hover:scale-105 transition-all bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fab fa-linkedin mr-2 text-gold"></i> LinkedIn
                </a>
                <a href={personalInfo.contact.github} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white hover:scale-105 transition-all bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fab fa-github mr-2 text-gold"></i> GitHub
                </a>
                <a href={personalInfo.contact.substack} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white hover:scale-105 transition-all bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fas fa-bookmark mr-2 text-gold"></i> Substack
                </a>
                <a href={personalInfo.contact.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-white hover:scale-105 transition-all bg-slate-800 bg-opacity-40 px-4 py-2 rounded-full border border-slate-600 border-opacity-50">
                    <i class="fab fa-youtube mr-2 text-gold"></i> YouTube
                </a>
            </div>
        </header>

        <!-- Summary Section -->
        <section id="summary" class="fade-in duration-700 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-8 text-white tracking-wide">Summary</h2>
            <ul class="list-none text-slate-200 text-justify">
                {personalInfo.summary.split('\n').filter(p => p.trim()).map((paragraph, index) => (
                    <li key={index} class="text-lg">
                        {paragraph.trim()}
                    </li>
                ))}
            </ul>
        </section>

        <!-- Experience Section -->
        <section id="experience" class="fade-in duration-900 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-12 text-white">Experience</h2>
            <div class="space-y-16">
                {experience.map((job, index) => (
                    <div key={index} class="relative pl-10 group">
                        <div class="absolute -left-3 top-2 border-l border-gold border-opacity-30 h-[calc(100%+2rem)] group-last:border-0"></div>
                        <div class="absolute -left-[1.35rem] top-3 w-4 h-4 bg-gold rounded-full border-4 border-slate-900 shadow-[0_0_10px_rgba(168,218,220,0.5)]"></div>
                        
                        <h3 class="text-2xl font-bold text-gold mb-1">{job.role}</h3>
                        <h4 class="text-xl font-semibold text-slate-100 mb-2">{job.company}</h4>
                        <p class="text-md text-slate-400 mb-6 font-medium italic">{job.location} | {job.period}</p>
                        <ul class="list-none space-y-4">
                            {job.responsibilities.map((resp, respIndex) => (
                                <li key={respIndex} class="text-slate-300 leading-relaxed pl-6 relative">
                                    <span class="absolute left-0 top-2 w-1.5 h-1.5 bg-slate-500 rounded-full"></span>
                                    {resp}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        <!-- Education Section -->
        <section id="education" class="fade-in duration-1100 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-12 text-white">Education</h2>
            <div class="space-y-16">
                {education.map((edu, index) => (
                    <div key={index} class="relative pl-10 group">
                        <div class="absolute -left-3 top-2 border-l border-gold border-opacity-30 h-[calc(100%+2rem)] group-last:border-0"></div>
                        <div class="absolute -left-[1.35rem] top-3 w-4 h-4 bg-gold rounded-full border-4 border-slate-900 shadow-[0_0_10px_rgba(168,218,220,0.5)]"></div>
                        
                        <h3 class="text-2xl font-bold text-gold mb-1">{edu.institution}</h3>
                        <h4 class="text-xl font-semibold text-slate-100 mb-2">{edu.degree}</h4>
                        <p class="text-md text-slate-400 mb-6 font-medium italic">{edu.location} | {edu.period}</p>
                        {edu.highlights && (
                            <ul class="list-none space-y-4">
                                {edu.highlights.map((highlight, hIndex) => (
                                    <li key={hIndex} class="text-slate-300 leading-relaxed pl-6 relative">
                                        <span class="absolute left-0 top-2 w-1.5 h-1.5 bg-slate-500 rounded-full"></span>
                                        {highlight}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                ))}
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills" class="fade-in duration-1300 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-10 text-white">Skills</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
                <div class="bg-slate-900 bg-opacity-40 p-6 rounded-xl border border-slate-700 border-opacity-30">
                    <h3 class="text-xl font-bold text-gold mb-6 border-b border-slate-700 pb-3">Technical</h3>
                    <ul class="list-none text-slate-300 space-y-3">
                        {skills.technical.map((skill, index) => <li key={index} class="flex items-center"><span class="w-1.5 h-1.5 bg-gold rounded-full mr-3 opacity-70"></span>{skill}</li>)}
                    </ul>
                </div>
                <div class="bg-slate-900 bg-opacity-40 p-6 rounded-xl border border-slate-700 border-opacity-30">
                    <h3 class="text-xl font-bold text-gold mb-6 border-b border-slate-700 pb-3">Programming</h3>
                    <ul class="list-none text-slate-300 space-y-3">
                        {skills.programming.map((skill, index) => <li key={index} class="flex items-center"><span class="w-1.5 h-1.5 bg-gold rounded-full mr-3 opacity-70"></span>{skill}</li>)}
                    </ul>
                </div>
                <div class="bg-slate-900 bg-opacity-40 p-6 rounded-xl border border-slate-700 border-opacity-30">
                    <h3 class="text-xl font-bold text-gold mb-6 border-b border-slate-700 pb-3">Applications</h3>
                    <ul class="list-none text-slate-300 space-y-3">
                        {skills.applications.map((skill, index) => <li key={index} class="flex items-center"><span class="w-1.5 h-1.5 bg-gold rounded-full mr-3 opacity-70"></span>{skill}</li>)}
                    </ul>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-slate-900 bg-opacity-40 p-6 rounded-xl border border-slate-700 border-opacity-30">
                    <h3 class="text-xl font-bold text-gold mb-6 border-b border-slate-700 pb-3">Languages</h3>
                    <ul class="flex flex-wrap gap-4 text-slate-300">
                        {skills.languages.map((lang, index) => (
                            <li key={index} class="bg-slate-800 px-4 py-2 rounded-full border border-slate-600 border-opacity-30 text-sm">
                                <span class="font-semibold text-white">{lang.name}</span> <span class="text-gold ml-1 text-xs px-2 py-0.5 bg-slate-900 rounded">{lang.level}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="fade-in duration-1500 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-12 text-white">Projects</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                {projects.map((project, index) => (
                    <div key={index} class="bg-slate-900 bg-opacity-40 p-8 rounded-xl border border-slate-700 border-opacity-30 hover:border-gold hover:border-opacity-50 transition-all duration-300 group">
                        <h3 class="text-2xl font-bold text-gold mb-2 group-hover:text-white transition-colors">{project.name} <span class="text-slate-400 text-lg font-normal ml-2">({project.year})</span></h3>
                        <p class="text-md text-slate-300 mb-6 leading-relaxed flex items-start">
                            <span class="text-gold mr-3 mt-1.5 opacity-70">▹</span>
                            {project.description}
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {project.tags.map((tag, tagIndex) => (
                                <span key={tagIndex} class="bg-slate-800 bg-opacity-80 border border-slate-600 text-slate-200 text-xs font-medium px-3 py-1.5 rounded-md">{tag}</span>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Publications & Patents Section -->
        <section id="publications" class="fade-in duration-1700 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-12 text-white">Publications & Patents</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div class="bg-slate-900 bg-opacity-40 p-8 rounded-xl border border-slate-700 border-opacity-30 relative group">
                    <h3 class="text-2xl font-bold text-gold mb-8 flex items-center"><i class="fas fa-book open ml-1 mr-3 opacity-70"></i> Publications</h3>
                    <div class="space-y-8">
                        {publications.map((pub, index) => (
                            <div key={index} class="relative pl-6">
                                <span class="absolute left-0 top-1.5 w-2 h-2 rounded-sm bg-slate-500 transform rotate-45"></span>
                                <p class="text-lg text-slate-200 font-semibold mb-1 leading-tight">{pub.title}</p>
                                <p class="text-sm text-slate-400 mb-1">{pub.authors}</p>
                                <p class="text-sm text-gold opacity-80">{pub.publication} <span class="text-slate-500 mx-1">|</span> {pub.date}</p>
                            </div>
                        ))}
                    </div>
                </div>
                <div class="bg-slate-900 bg-opacity-40 p-8 rounded-xl border border-slate-700 border-opacity-30 relative group">
                    <h3 class="text-2xl font-bold text-gold mb-8 flex items-center"><i class="fas fa-certificate ml-1 mr-3 opacity-70"></i> Patents</h3>
                    <div class="space-y-8">
                        {patents.map((patent, index) => (
                            <div key={index} class="relative pl-6">
                                <span class="absolute left-0 top-1.5 w-2 h-2 rounded-sm bg-slate-500 transform rotate-45"></span>
                                <p class="text-lg text-slate-200 font-semibold mb-1 leading-tight">{patent.title}</p>
                                <p class="text-sm text-gold opacity-80">{patent.number} <span class="text-slate-500 mx-1">|</span> {patent.date}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Video Gallery Section -->
        <section id="videos" class="fade-in duration-1600 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl">
            <h2 class="section-title text-4xl font-bold playfair-display mb-8 text-white">Aerial Photography & Cinematography</h2>
            <div class="prose prose-slate max-w-none mb-10">
                <p class="text-lg text-slate-300">A selection of my drone cinematography from various hiking trips accross Switzerland. Having a bird's eye view gives you perspective and helps you look for new fields to explore.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- YouTube embeds -->
                                    <div class="mt-6 text-center">
                        <a href={personalInfo.contact.youtube} target="_blank" rel="noopener noreferrer" class="inline-block bg-slate-800 hover:bg-gold hover:text-navy border border-slate-600 hover:border-gold text-slate-200 transition-all font-semibold px-6 py-2.5 rounded-full shadow-lg">
                            <i class="fab fa-youtube mr-2"></i> View Full Channel
                        </a>
                    </div>
                <div class="bg-slate-900 bg-opacity-50 p-4 rounded-xl overflow-hidden border border-slate-700 border-opacity-30">
<div class="aspect-video relative rounded-lg overflow-hidden border border-slate-800 shadow-xl">
<iframe width="560" height="315" src="https://www.youtube.com/embed/SWjpgFl0xL4?si=WlCUmDR422HhNZdz" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>
<div class="aspect-video relative rounded-lg overflow-hidden border border-slate-800 shadow-xl">
<iframe width="560" height="315" src="https://www.youtube.com/embed/FXm4mPVUjt0?si=uzozMpnylMlT4WET" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>
<div class="aspect-video relative rounded-lg overflow-hidden border border-slate-800 shadow-xl">
<iframe width="560" height="315" src="https://www.youtube.com/embed/nOzbNlL3HHs?si=16lonOmpV5KVgGIM" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>

                </div>

            </div>
        </section>
        
        <!-- Personal Interests Section -->
        <section id="interests" class="fade-in duration-1900 glass-panel section-wrap pb-16 md:pb-20 p-8 md:p-12 lg:px-20 rounded-2xl text-center mb-12">
            <h2 class="section-title text-4xl font-bold playfair-display mb-10 text-white inline-block">Personal Interests</h2>
            <div class="flex flex-wrap justify-center gap-4">
                {personalInterests.map((interest, index) => (
                    <span key={index} class="px-6 py-3 bg-slate-900 bg-opacity-60 border border-slate-700 text-slate-200 text-lg rounded-full hover:bg-gold hover:text-navy hover:border-gold transition-all duration-300 font-medium cursor-default shadow-md">
                        {interest}
                    </span>
                ))}
            </div>
        </section>

    </main>
</Layout>

<style>
    .playfair-display {
        font-family: 'Playfair Display', serif;
    }

    /* Fade-in effect */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeIn 0.8s ease-out forwards;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .section-title::before {
        content: '';
        display: block;
        width: 180px;
        height: 4px;
        background: linear-gradient(90deg, var(--gold), var(--slate-light) 80%, transparent);
        margin-bottom: 24px;
    }
    
    /* Header shadow on scroll */
    .header-scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        background: rgba(15, 23, 42, 0.95); /* Semi-transparent dark background */
    }

    /* Responsive adjustments */
    @media (max-width: 640px) { /* sm */
        .fade-in { animation-duration: 0.6s; }
        .section-title::before { width: 120px; }
        h1 { font-size: 2.5rem; } /* 40px */
        h2 { font-size: 1.75rem; } /* 28px */
        h3 { font-size: 1.5rem; } /* 24px */
        p, li { font-size: 1rem; } /* 16px */
    }
    @media (min-width: 768px) { /* md */
        h1 { font-size: 4rem; } /* 64px */
        h2 { font-size: 2.25rem; } /* 36px */
        h3 { font-size: 1.75rem; } /* 28px */
        p, li { font-size: 1.125rem; } /* 18px */
    }
    @media (min-width: 1024px) { /* lg */
        h1 { font-size: 4.5rem; } /* 72px */
        h2 { font-size: 2.5rem; } /* 40px */
        h3 { font-size: 2rem; } /* 32px */
    }
</style>
